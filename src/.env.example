APP_NAME=ApplebBoss
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app_name
DB_USERNAME=root
DB_PASSWORD=

QUEUE_CONNECTION=database
BROADCAST_DRIVER=log
CACHE_STORE=database
CACHE_DRIVER=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/oauth2callback
GOOGLE_DRIVE_FOLDER_ID=

AUTOMATION_TOKEN=

VITE_APP_NAME="${APP_NAME}"

# Proxies de confianza para X-Forwarded-*. Vacío = no confiar en nadie (recomendado sin proxy).
# Detrás de un reverse proxy/túnel, pon su IP o red, ej.: TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=

# ── Endurecimiento para PRODUCCIÓN ──────────────────────────────────────────
# APP_ENV debe ser exactamente "production" (así se activan HTTPS forzado, HSTS,
# la CSP estricta y la verificación de contraseñas filtradas).
# APP_ENV=production
# APP_DEBUG=false
# Cookies solo por HTTPS (evita que la sesión viaje en claro):
# SESSION_SECURE_COOKIE=true

# ── Automatización (n8n) ────────────────────────────────────────────────────
# Token que usa n8n (test, top-products, reports). Genera uno con: php artisan automation:token
# AUTOMATION_TOKEN=
# Durante una rotación, deja aquí los tokens viejos (separados por coma) hasta actualizar n8n; después vacíalo.
AUTOMATION_TOKENS_PREVIOS=
# Token APARTE para el export financiero (/api/automation/reportes/exportar). n8n NO lo usa.
# Vacío = ese endpoint queda cerrado por automatización (el admin exporta desde el panel).
AUTOMATION_EXPORT_TOKEN=

# ── Horario laboral del vendedor ────────────────────────────────────────────
# El vendedor solo inicia sesión de 09:00 a 13:00 y de 14:00 a 19:00 (America/La_Paz).
# Se configura en config/horario.php (ventanas y días). El admin no tiene restricción.

# ── Primera cuenta de administrador (php artisan db:seed) ───────────────────
# Solo crea la cuenta si todavía no existe y nunca cambia una contraseña. Nunca escribas contraseñas ni correos en
# el código: el repositorio es público. Después de crearla, borra SEED_ADMIN_PASSWORD de tu .env.
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
