  "cards": [
    {
      "dot": "emerald",
      "title": "Alta · corregido",
      "items": [
        "H1 · Límites por IP: TRUSTED_PROXIES por env (ya no se burla con X-Forwarded-For)",
        "H2 · El vendedor ya no recibe costo/procedencia (SinCostos::purgar en todos los niveles)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Media · corregido",
      "items": [
        "H3 · dompdf enable_remote=false (sin SSRF en el PDF)",
        "H4 · OAuth de Drive con state anti-CSRF",
        "H5 · Export financiero a token aparte (n8n intacto) + rotación"
      ]
    },
    {
      "dot": "cyan",
      "title": "Baja y controles nuevos",
      "items": [
        "H6 · «Olvidé mi contraseña» con mensaje neutro",
        "H7 · Blindaje público: honeypots, throttle, strip_tags, no-store",
        "H8 · Horario del vendedor: no inicia sesión fuera de 09–13 / 14–19"
      ]
    }
  ]
